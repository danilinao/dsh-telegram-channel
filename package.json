{
  "name": "dsh-telegram-channel-ru",
  "version": "0.9.0",
  "description": "Telegram-пульт для DeepSeek Harness: живая Web-сессия на телефоне — русский интерфейс, архивные сессии скрыты, имя сессии на кнопке",
  "keywords": [
    "telegram",
    "bot",
    "mobile",
    "remote",
    "channel",
    "sessions",
    "workspace",
    "model",
    "bind",
    "unbind",
    "remove",
    "clear",
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "agent",
    "live-session",
    "russian",
    "localization",
    "ru"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danilinao/dsh-telegram-channel-ru.git"
  },
  "bugs": {
    "url": "https://github.com/danilinao/dsh-telegram-channel-ru/issues"
  },
  "homepage": "https://github.com/danilinao/dsh-telegram-channel-ru#readme",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./client": "./client/client.js"
  },
  "files": [
    "lib",
    "client",
    "src",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "UPSTREAM.md",
    "BUILD.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf lib",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:native": "node --test tests/",
    "check": "npm run typecheck && npm run build && npm test && npm run test:lib",
    "prepublishOnly": "npm run clean && npm run build && npm test && npm run test:lib",
    "test:lib": "node --import tsx --test tests/lib/*.test.ts",
    "test:browser": "node tests/browser/run.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5-alpha.1",
    "@deepseek-ai/dsh-agent": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-llm": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-session": "^0.2.1-alpha.2",
    "@deepseek-ai/schemastery": "^3.18.5-alpha.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.1",
    "@deepseek-ai/dsh-agent": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-llm": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-session": "0.2.1-alpha.2",
    "@deepseek-ai/schemastery": "3.18.5-alpha.1",
    "@types/node": "^26.6.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "undici": "^7.29.0"
  },
  "author": "Alexey Danilin",
  "contributors": [
    {
      "name": "hi-wenw/dsh-telegram-channel contributors",
      "url": "https://github.com/hi-wenw/dsh-telegram-channel"
    }
  ]
}
